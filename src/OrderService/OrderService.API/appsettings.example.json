{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Warning",
      "OpenIddict": "Debug",
      "Microsoft.AspNetCore.Authentication": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrdersConnection": "Server=Your_Server;Database=OrderDb;User Id=Your_Username;Password=Your_Password;TrustServerCertificate=True;"
    //"OrdersConnection": "Server=DESKTOP-O1E4QQ7\\SQLEXPRESS;Database=OrderDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "EventBus": {
    "HostName": "localhost",
    "UserName": "Your_Username",
    "Password": "Your_Password",
    "ExchangeName": "ecommerce.events",
    "RoutingKeys": {
      "OrderCreatedIntegrationEvent": "order.created",
      "OrderCompletedIntegrationEvent": "order.completed"
    },
    "Subscriptions": [
      {
        "EventName": "payment.succeeded",
        "QueueName": "order.payment.queue"
      },
      {
        "EventName": "payment.failed",
        "QueueName": "order.payment.queue"
      }
    ]
  },
  "GrpcSettings": {
    "CatalogUrl": "https://localhost:5200"
  },
  "OpenIddict": {
    "Issuer": "http://localhost:5014"
  }
}

