{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PaymentConnection": "Server=Your_Server;Database=PaymentDb;User Id=Your_Username;Password=Your_Password;TrustServerCertificate=True;"
  },
  "EventBus": {
    "HostName": "localhost",
    "UserName": "Your_Username",
    "Password": "Your_Password",
    "ExchangeName": "ecommerce.events",
    "RoutingKeys": {
      "PaymentSucceededIntegrationEvent": "payment.succeeded",
      "PaymentFailedIntegrationEvent": "payment.failed"
    },
    "Subscriptions": [
      {
        "EventName": "order.created",
        "QueueName": "payment.orders.queue"
      }
    ]
  },
  "OpenIddict": {
    "Issuer": "http://localhost:5014"
  }
}
