{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityConnection": "Server=Your_Server;Database=IdentityDb;User Id=Your_Username;Password=Your_Password;TrustServerCertificate=True;"
  },
  "EventBus": {
    "HostName": "localhost",
    "UserName": "Your_Username",
    "Password": "Your_Password",
    "ExchangeName": "ecommerce.events"
  },
  "JwtSettings": {
    "Key": "Your_Secret_Key",
    "Issuer": "EcommerceIdentity",
    "Audience": "EcommerceClient",
    "DurationInMinutes": 60
  },
  "OpenIddict": {
    "Issuer": "http://localhost:5014"
  }
}
