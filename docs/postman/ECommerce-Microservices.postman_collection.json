      "name": "Identity",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200/201\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200,201]);\r",
                  "});\r",
                  "\r",
                  "const body = pm.request.body.raw\r",
                  "const request = JSON.parse(body)\r",
                  "\r",
                  "const userId = pm.response.json()\r",
                  "\r",
                  "pm.collectionVariables.set(\"userId\", userId)\r",
                  "pm.collectionVariables.set(\"email\", request.email)\r",
                  "pm.collectionVariables.set(\"password\", request.password)\r",
                  "\r",
                  "console.log(\"User ID:\", userId)"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disabledSystemHeaders": {}
          },
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"Ali Khan\",\r\n  \"email\": \"ali@test.com\",\r\n  \"password\": \"Ali@12345\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
