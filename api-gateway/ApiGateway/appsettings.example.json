{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenIddict": {
    "Issuer": "http://localhost:5014"
  },
  "ReverseProxy": {
    "Routes": {
      "catalogRoute": {
        "ClusterId": "catalogCluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [
          { "PathRemovePrefix": "/catalog" }
        ]
      },
      "ordersRoute": {
        "ClusterId": "ordersCluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [
          { "PathRemovePrefix": "/orders" }
        ]
      },
      "identityRoute": {
        "ClusterId": "identityCluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      }
    },
    "Clusters": {
      "catalogCluster": {
        "Destinations": {
          "catalog1": { "Address": "http://localhost:5108/" }
        }
      },
      "ordersCluster": {
        "Destinations": {
          "orders1": { "Address": "http://localhost:5278/" }
        }
      },
      "identityCluster": {
        "Destinations": {
          "identity1": { "Address": "http://localhost:5014/" }
        }
      }
    }
  }
}